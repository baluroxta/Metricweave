# =================================================================
# METRICWEAVE AI — ENVIRONMENT CONFIGURATION
# Tagline: From raw data to clear decisions.
# Developed by Kandala Guru Balaji
# =================================================================

# -----------------------------------------------------------------
# 1. OPTIONAL: AI INFERENCE (TOGETHER AI)
# -----------------------------------------------------------------
# When provided, MetricWeave AI uses Together AI (Meta Llama 3.1 8B)
# for natural language Q&A and AI-assisted summaries.
# If omitted or left empty, MetricWeave AI runs 100% deterministically
# in offline mode with zero crashes.
TOGETHER_API_KEY=your_together_ai_api_key_here

# -----------------------------------------------------------------
# 2. OPTIONAL: PERSISTENT DATABASE (POSTGRESQL / NEON)
# -----------------------------------------------------------------
# If provided, chat histories and generated artifacts are stored in Neon.
# If omitted, MetricWeave AI automatically uses the resilient local
# filesystem and in-memory storage engine.
DATABASE_URL=postgresql://user:password@ep-sample-pool.region.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------
# 3. OPTIONAL: S3 FILE STORAGE
# -----------------------------------------------------------------
# By default, files are safely processed in local disk storage (uploads/).
# Set these only if you wish to upload raw files to AWS S3.
S3_UPLOAD_KEY=your_aws_s3_key_here
S3_UPLOAD_SECRET=your_aws_s3_secret_here
S3_UPLOAD_BUCKET=your_s3_bucket_name_here
S3_UPLOAD_REGION=us-east-1

# -----------------------------------------------------------------
# 4. OPTIONAL: LLM OBSERVABILITY
# -----------------------------------------------------------------
HELICONE_API_KEY=your_helicone_key_here
